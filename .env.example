# Postgres connection string from Supabase: Project Settings > Database >
# Connect > "Transaction pooler". Use the POOLER string (port 6543), not the
# direct connection (port 5432) — the direct port gets blocked outbound on
# some networks (seen during Day 1 testing: ETIMEDOUT on 5432), and the
# pooler is what we'll want anyway once deployed serverless.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Secret used to sign and verify session JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=
