# Use Supabase's connection pooler string (port 6543), not the direct
# connection (5432) — direct gets blocked outbound on some networks.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
# Optional: database connections per running copy of the site (default 10). Use 1–3 on serverless hosting.
# DATABASE_POOL_MAX=10

# Long random value, e.g. generated with: openssl rand -base64 48
JWT_SECRET=

# Image library (Supabase Storage). Server-only: never prefix these with NEXT_PUBLIC_.
# URL: Project Settings → API. Key: the secret (sb_secret_…) or legacy service_role key.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket created in Storage; defaults to handbook-media.
SUPABASE_STORAGE_BUCKET=handbook-media
# Private bucket for archived login records (Activity → Archives).
SUPABASE_ARCHIVE_BUCKET=log-archives
# Private bucket for Handbook audio (MP3); defaults to handbook-audio. Allow audio/mpeg if file types are limited.
SUPABASE_AUDIO_BUCKET=handbook-audio

# Voice service for Handbook translations and audio (server only). The free Gemini key is for building and
# testing only: Google's terms don't allow the free tier for UK users, so use a paid (billed) key before go-live.
GEMINI_API_KEY=
# gemini (default) or fake (stand-in for local trials and tests; refused in production).
# VOICE_PROVIDER=gemini
# Optional overrides when Google renames or adds models and voices:
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# How long the text model thinks before translating: minimal, low, medium or high (default: low for pages,
# minimal for question pages; a value here applies to both).
# GEMINI_THINKING_LEVEL=low
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# VOICE_READING_STYLE=Calm, clear and steady, at a moderate teaching pace
