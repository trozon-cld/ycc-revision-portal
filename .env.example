# Postgres (AWS RDS): the database's endpoint name, not its IP address (the certificate check needs the name).
# Letters and numbers only in the password, or percent-encode it. No sslmode here: DATABASE_SSL decides.
# The user is the site's own login, ycc_portal (made with supabase/limited-login.sql), not the master login.
DATABASE_URL=postgresql://ycc_portal:[PASSWORD]@[NAME].[ID].eu-west-2.rds.amazonaws.com:5432/[DATABASE]
# Optional: the certificate check. "verify" (default) checks the server's certificate against AWS's RDS certificates
# (lib/db/aws-rds-ca.mjs) and its name; "no-verify" only encrypts (another provider, logs a warning).
# DATABASE_SSL=verify
# Optional: another provider's certificate file, used instead of AWS's.
# DATABASE_SSL_CA_FILE=
# Optional: database connections per running copy of the site (default 10). Use 1–3 on serverless hosting (Amplify: 3).
# DATABASE_POOL_MAX=10

# Optional host and plan sizes (server only; a missing or invalid value uses the default).
# The largest request or response the host lets through, in MB (default 4.5: under Amplify's 5.72 MB response limit).
# Picture uploads, bulk upload, restore and backup downloads stay under it. A host with a higher limit (ECS) may raise it.
# HOST_REQUEST_LIMIT_MB=4.5
# Total storage for pictures, archived login records, audio and database backups, in MB (default 20000, about 20 GB).
# S3 has no fixed size: this is a cost cap. Uploads and new audio stop when it's reached.
# STORAGE_LIMIT_MB=20000
# The visitor's address: hosts add the address they saw to the end of X-Forwarded-For, and anything before it can be
# faked, so it's read this many entries from the end (default 1, the last: right for ECS's load balancer and Vercel).
# Check it on Office Network ("Addresses seen by the server"). Login limits, login records and the office check use it.
# Amplify: 2 (its CloudFront server adds one entry after the visitor). ECS behind a load balancer: 1.
# TRUSTED_PROXY_HOPS=1

# Long random value, e.g. generated with: openssl rand -base64 48
JWT_SECRET=
# Needed wherever more than one copy of the site runs (Amplify, ECS): every copy then accepts the same forms, and a
# redeploy doesn't break pages already open. 32 random bytes in base64, no "$":
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# File storage (Amazon S3). Server-only: never prefix these with NEXT_PUBLIC_. All five are required.
# Four private buckets (Block all public access on) in the same region as the site. S3 bucket names are unique
# across all of AWS, so add your own ending, e.g. ycc-dev-handbook-media-k7p2.
S3_REGION=eu-west-2
# Pictures (Media, Handbook, covers).
S3_MEDIA_BUCKET=
# Archived login records (Activity → Archives).
S3_ARCHIVE_BUCKET=
# Handbook audio (MP3).
S3_AUDIO_BUCKET=
# Database backups (Backup & Restore → Backup). The files hold accounts and logs: never make this bucket public.
S3_BACKUP_BUCKET=
# Permission: on AWS the host's role gives it (no keys). On a developer's PC only, the access key of a dev-only IAM
# user limited to the dev buckets (never a root key, never in production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Tests and S3-compatible stores only; leave unset on AWS.
# S3_ENDPOINT=

# The daily database backup's schedule (EventBridge) calls /api/cron/database-backup with this secret; at least 16
# characters (e.g. openssl rand -base64 32). Without it the schedule's link stays closed.
CRON_SECRET=

# Voice service for Handbook translations and audio (server only).
# Google Cloud (billed project, Cloud Translation and Cloud Text-to-Speech APIs turned on): an API key
# restricted to those two APIs. It translates and makes the audio (WaveNet voices).
GOOGLE_CLOUD_API_KEY=
# google (default) or fake (stand-in for local trials and tests; refused in production).
# VOICE_PROVIDER=google
# Welsh audio is read by Gemini (Google has no Welsh voice; set per language in lib/voice/language-catalogue.ts).
# Billed key before candidates hear it.
GEMINI_API_KEY=
# Optional overrides when Google renames Gemini's speech model or voices:
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# VOICE_READING_STYLE=Calm, clear and steady, at a moderate teaching pace
